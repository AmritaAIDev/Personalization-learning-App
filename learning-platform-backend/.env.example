# PostgreSQL connection string. Keep this private and never commit a real value.
# In Vercel, add this in Project Settings -> Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Keep TLS verification enabled in production.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Comma-separated browser origins allowed to make credentialed API requests.
# Local development:
# FRONTEND_ORIGIN=http://localhost:3000
#
# Vercel production example:
# FRONTEND_ORIGIN=https://your-frontend-project.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
PORT=4000
NODE_ENV=development

# DeepSeek is accessed only by the backend through its OpenAI-compatible API.
# Never expose this value through a NEXT_PUBLIC_* variable or commit a real key.
# Leaving this empty is supported: the tutor, flashcard generation, and
# low-supply question generation fall back to database-only behaviour, and the
# rest of the platform runs normally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional retrieval grounding for AI question generation.
QDRANT_URL=
QDRANT_API_KEY=

# Error tracking. Leave SENTRY_DSN empty to disable it entirely: the SDK is
# never started and no data leaves the server.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Fraction of requests traced, between 0 and 1. Errors are always captured.
SENTRY_TRACES_SAMPLE_RATE=0.1
