# PostgreSQL connection string. Keep this private and never commit a real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Keep TLS verification enabled in production.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Comma-separated browser origins allowed to make credentialed API requests.
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development

# DeepSeek is accessed only by the backend through its OpenAI-compatible API.
# Never expose this value through a NEXT_PUBLIC_* variable or commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional retrieval grounding for AI question generation.
QDRANT_URL=
QDRANT_API_KEY=
