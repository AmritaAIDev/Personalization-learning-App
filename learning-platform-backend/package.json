{
  "name": "learning-platform-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seed-diagnostic.ts",
    "seed:diagnostic": "ts-node -r tsconfig-paths/register src/scripts/seed-diagnostic.ts",
    "seed:adaptive": "ts-node -r tsconfig-paths/register src/scripts/seed-adaptive-learning.ts",
    "seed:demo-history": "ts-node -r tsconfig-paths/register src/scripts/seed-demo-history.ts",
    "seed:demo-experience": "npm run seed:demo-history && npm run seed:thin-topup && npm run seed:course-coverage && npm run seed:multi-subject-journey",
    "seed:course-coverage": "ts-node -r tsconfig-paths/register src/scripts/seed-course-coverage.ts",
    "seed:align-chapters": "ts-node -r tsconfig-paths/register src/scripts/align-gauss-chapter.ts",
    "seed:thin-topup": "ts-node -r tsconfig-paths/register src/scripts/seed-thin-topup.ts",
    "seed:multi-subject-journey": "ts-node -r tsconfig-paths/register src/scripts/seed-multi-subject-journey.ts",
    "seed:laws-of-motion": "ts-node -r tsconfig-paths/register src/scripts/seed-laws-of-motion.ts",
    "seed:work-energy-power": "ts-node -r tsconfig-paths/register src/scripts/seed-work-energy-power.ts",
    "seed:gravitation": "ts-node -r tsconfig-paths/register src/scripts/seed-gravitation.ts",
    "seed:complex-numbers": "ts-node -r tsconfig-paths/register src/scripts/seed-complex-numbers.ts",
    "seed:permutations-combinations": "ts-node -r tsconfig-paths/register src/scripts/seed-permutations-combinations.ts",
    "seed:kinematics": "ts-node -r tsconfig-paths/register src/scripts/seed-kinematics.ts",
    "seed:thermodynamics-physics": "ts-node -r tsconfig-paths/register src/scripts/seed-thermodynamics-physics.ts",
    "seed:current-electricity": "ts-node -r tsconfig-paths/register src/scripts/seed-current-electricity.ts",
    "seed:redox-reactions": "ts-node -r tsconfig-paths/register src/scripts/seed-redox-reactions.ts",
    "seed:states-of-matter": "ts-node -r tsconfig-paths/register src/scripts/seed-states-of-matter.ts",
    "seed:binomial-theorem": "ts-node -r tsconfig-paths/register src/scripts/seed-binomial-theorem.ts",
    "seed:sequences-series": "ts-node -r tsconfig-paths/register src/scripts/seed-sequences-series.ts",
    "seed:trigonometric-functions": "ts-node -r tsconfig-paths/register src/scripts/seed-trigonometric-functions.ts",
    "seed:journey:development": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "seed:syllabus": "ts-node -r tsconfig-paths/register src/scripts/seed-jee-syllabus.ts",
    "seed:qdrant:syllabus": "ts-node -r tsconfig-paths/register src/scripts/seed-qdrant-syllabus.ts",
    "generate:content": "ts-node -r tsconfig-paths/register src/scripts/generate-chapter-content.ts",
    "seed:postgres": "ts-node seed-postgres.ts",
    "seed:qdrant": "ts-node seed-qdrant.ts",
    "seed:qdrant:full": "ts-node seed-qdrant-full-chapter.ts",
    "seed:qdrant:scrape": "ts-node scrape-qdrant.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand --forceExit",
    "check:schema-drift": "ts-node -r tsconfig-paths/register src/scripts/check-schema-drift.ts",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "migrate:deploy": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "audit:coverage": "ts-node -r tsconfig-paths/register src/scripts/audit-question-coverage.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@qdrant/js-client-rest": "^1.18.0",
    "@sentry/nestjs": "^10.71.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "openai": "^6.46.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0"
  },
  "overrides": {
    "js-yaml": "5.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
